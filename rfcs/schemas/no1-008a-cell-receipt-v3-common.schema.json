{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://tree-sitter-analyzer.invalid/schemas/no1-008a-cell-receipt-v3-common.schema.json",
 "$defs": {
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "positive": {
   "type": "integer",
   "minimum": 1
  },
  "nonnegative": {
   "type": "integer",
   "minimum": 0
  },
  "blob": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "size_bytes",
    "sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/relativePath"
    },
    "size_bytes": {
     "$ref": "#/$defs/nonnegative"
    },
    "sha256": {
     "$ref": "#/$defs/hash"
    }
   }
  },
  "signature": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key_id",
    "algorithm",
    "signature"
   ],
   "properties": {
    "key_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "algorithm": {
     "const": "Ed25519"
    },
    "signature": {
     "type": "string",
     "pattern": "^[0-9a-f]{128}$"
    }
   }
  },
  "execution": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "argv",
    "cwd",
    "environment_digest",
    "exit_code",
    "stdout_bytes",
    "stderr_bytes",
    "query_bytes",
    "final_index_observation"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "argv": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     }
    },
    "cwd": {
     "$ref": "#/$defs/absolutePath"
    },
    "environment_digest": {
     "$ref": "#/$defs/hash"
    },
    "exit_code": {
     "type": "integer"
    },
    "stdout_bytes": {
     "$ref": "#/$defs/blob"
    },
    "stderr_bytes": {
     "$ref": "#/$defs/blob"
    },
    "query_bytes": {
     "$ref": "#/$defs/blob"
    },
    "final_index_observation": {
     "$ref": "#/$defs/blob"
    }
   }
  },
  "eligibility": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "repo_id",
    "source_rules_hash",
    "commit",
    "tracked_regular_paths",
    "tracked_entries",
    "tracked_files",
    "eligible_paths",
    "prefilter_exclusions",
    "tracked_inventory_hash",
    "eligible_paths_hash",
    "repo_fingerprint"
   ],
   "properties": {
    "repo_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "source_rules_hash": {
     "$ref": "#/$defs/hash"
    },
    "commit": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "tracked_regular_paths": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/relativePath"
     },
     "uniqueItems": true
    },
    "eligible_paths": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/relativePath"
     },
     "uniqueItems": true
    },
    "prefilter_exclusions": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "minLength": 1
       },
       {
        "type": "string",
        "minLength": 1
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
     }
    },
    "tracked_inventory_hash": {
     "$ref": "#/$defs/hash"
    },
    "eligible_paths_hash": {
     "$ref": "#/$defs/hash"
    },
    "repo_fingerprint": {
     "$ref": "#/$defs/hash"
    },
    "tracked_entries": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
       {
        "$ref": "#/$defs/relativePath"
       },
       {
        "enum": [
         "100644",
         "100755",
         "120000",
         "160000"
        ]
       },
       {
        "type": "string",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
       }
      ]
     }
    },
    "tracked_files": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
       {
        "$ref": "#/$defs/relativePath"
       },
       {
        "enum": [
         "100644",
         "100755"
        ]
       },
       {
        "type": "string",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
       },
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "$ref": "#/$defs/hash"
       }
      ]
     }
    }
   }
  },
  "relativePath": {
   "type": "string",
   "minLength": 1,
   "maxLength": 4096,
   "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[,\\\\\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
  },
  "absolutePath": {
   "type": "string",
   "minLength": 2,
   "maxLength": 4096,
   "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[,\\\\\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
  }
 }
}
