{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "no1-008a-cell-receipt-v3.schema.json",
  "title": "NO1-008A detached cell receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "body",
    "body_sha256",
    "executor_signature",
    "approver_signature",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "body_sha256": {
      "$ref": "#/$defs/hash"
    },
    "executor_signature": {
      "$ref": "#/$defs/signature"
    },
    "approver_signature": {
      "$ref": "#/$defs/signature"
    },
    "receipt_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "environment_digest",
        "exit_code",
        "stdout_bytes",
        "stderr_bytes",
        "query_bytes",
        "index_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "cwd": {
          "$ref": "#/$defs/absolutePath"
        },
        "environment_digest": {
          "$ref": "#/$defs/hash"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_bytes": {
          "$ref": "#/$defs/blob"
        },
        "stderr_bytes": {
          "$ref": "#/$defs/blob"
        },
        "query_bytes": {
          "$ref": "#/$defs/blob"
        },
        "index_bytes": {
          "$ref": "#/$defs/blob"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "plan",
        "source",
        "environment",
        "counters",
        "resources",
        "executions",
        "index_partition",
        "snapshot",
        "process_audit",
        "oracle_approval",
        "run_nonce",
        "role_images"
      ],
      "properties": {
        "cell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_id",
            "arm_id",
            "attempt",
            "artifact_path"
          ],
          "properties": {
            "repo_id": {
              "enum": [
                "vscode",
                "excalidraw",
                "django",
                "tokio",
                "okhttp",
                "gin",
                "alamofire"
              ]
            },
            "arm_id": {
              "enum": [
                "tsa-warm",
                "codegraph-warm"
              ]
            },
            "attempt": {
              "const": 1
            },
            "artifact_path": {
              "type": "string",
              "pattern": "^cells/(vscode|excalidraw|django|tokio|okhttp|gin|alamofire)/(tsa-warm|codegraph-warm)/cell-receipt\\.json$"
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_hash",
            "plan_set_hash",
            "tool_sha256",
            "config_sha256",
            "image_digest",
            "seccomp_sha256"
          ],
          "properties": {
            "plan_hash": {
              "$ref": "#/$defs/hash"
            },
            "plan_set_hash": {
              "$ref": "#/$defs/hash"
            },
            "tool_sha256": {
              "$ref": "#/$defs/hash"
            },
            "config_sha256": {
              "$ref": "#/$defs/hash"
            },
            "seccomp_sha256": {
              "$ref": "#/$defs/hash"
            },
            "image_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "eligibility",
            "repo_fingerprint",
            "mount_target",
            "read_only"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "eligibility": {
              "$ref": "#/$defs/eligibility"
            },
            "repo_fingerprint": {
              "$ref": "#/$defs/hash"
            },
            "mount_target": {
              "const": "/source"
            },
            "read_only": {
              "const": true
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment_digest",
            "image_digest",
            "docker_security_flags",
            "network_mode",
            "seccomp_sha256",
            "credentials_stripped"
          ],
          "properties": {
            "environment_digest": {
              "$ref": "#/$defs/hash"
            },
            "image_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "docker_security_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "network_mode": {
              "const": "none"
            },
            "seccomp_sha256": {
              "$ref": "#/$defs/hash"
            },
            "credentials_stripped": {
              "const": true
            }
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api_cost_usd",
            "input_tokens",
            "model_calls",
            "network_requests",
            "output_tokens",
            "provider_requests"
          ],
          "properties": {
            "api_cost_usd": {
              "type": "number",
              "const": 0
            },
            "input_tokens": {
              "type": "number",
              "const": 0
            },
            "model_calls": {
              "type": "number",
              "const": 0
            },
            "network_requests": {
              "type": "number",
              "const": 0
            },
            "output_tokens": {
              "type": "number",
              "const": 0
            },
            "provider_requests": {
              "type": "number",
              "const": 0
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_digest",
            "wall_ns",
            "cpu_usec",
            "io_bytes",
            "memory_peak_bytes",
            "pids_peak"
          ],
          "properties": {
            "plan_digest": {
              "$ref": "#/$defs/hash"
            },
            "wall_ns": {
              "$ref": "#/$defs/nonnegative"
            },
            "cpu_usec": {
              "$ref": "#/$defs/nonnegative"
            },
            "io_bytes": {
              "$ref": "#/$defs/nonnegative"
            },
            "memory_peak_bytes": {
              "$ref": "#/$defs/nonnegative"
            },
            "pids_peak": {
              "$ref": "#/$defs/nonnegative"
            }
          }
        },
        "executions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/execution"
                },
                {
                  "properties": {
                    "id": {
                      "const": "delete"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/execution"
                },
                {
                  "properties": {
                    "id": {
                      "const": "build"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/execution"
                },
                {
                  "properties": {
                    "id": {
                      "const": "health"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/execution"
                },
                {
                  "properties": {
                    "id": {
                      "const": "symbol"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/execution"
                },
                {
                  "properties": {
                    "id": {
                      "const": "call"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            }
          ],
          "items": false
        },
        "index_partition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "indexed_paths",
            "excluded_paths",
            "parse_error_paths",
            "indexed_paths_hash",
            "excluded_paths_hash",
            "parse_error_paths_hash"
          ],
          "properties": {
            "indexed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "excluded_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "parse_error_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "indexed_paths_hash": {
              "$ref": "#/$defs/hash"
            },
            "excluded_paths_hash": {
              "$ref": "#/$defs/hash"
            },
            "parse_error_paths_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "data_image_sha256",
            "data_image_size",
            "hash_image_sha256",
            "hash_image_size",
            "root_hash",
            "salt",
            "data_block_size",
            "hash_block_size",
            "data_blocks",
            "tree_hash",
            "index_content_hash"
          ],
          "properties": {
            "format": {
              "const": "dm-verity-v1"
            },
            "data_image_sha256": {
              "$ref": "#/$defs/hash"
            },
            "hash_image_sha256": {
              "$ref": "#/$defs/hash"
            },
            "root_hash": {
              "$ref": "#/$defs/hash"
            },
            "salt": {
              "$ref": "#/$defs/hash"
            },
            "tree_hash": {
              "$ref": "#/$defs/hash"
            },
            "index_content_hash": {
              "$ref": "#/$defs/hash"
            },
            "data_image_size": {
              "$ref": "#/$defs/positive"
            },
            "hash_image_size": {
              "$ref": "#/$defs/positive"
            },
            "data_block_size": {
              "$ref": "#/$defs/positive"
            },
            "hash_block_size": {
              "$ref": "#/$defs/positive"
            },
            "data_blocks": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "process_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer_container_id",
            "image_digest",
            "cgroup_id",
            "network_mode",
            "security_opt",
            "restart_count",
            "terminal_pid",
            "launch_count",
            "cgroup_processes_after_stop",
            "pid1_exit",
            "run_nonce",
            "resource_observations",
            "audit_bytes"
          ],
          "properties": {
            "producer_container_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "image_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "cgroup_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "network_mode": {
              "const": "none"
            },
            "security_opt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "restart_count": {
              "const": 0
            },
            "terminal_pid": {
              "const": 0
            },
            "launch_count": {
              "const": 1
            },
            "cgroup_processes_after_stop": {
              "const": []
            },
            "pid1_exit": {
              "type": "integer"
            },
            "run_nonce": {
              "$ref": "#/$defs/hash"
            },
            "resource_observations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wall_ns",
                "cpu_usec",
                "io_bytes",
                "memory_peak_bytes",
                "pids_peak"
              ],
              "properties": {
                "wall_ns": {
                  "$ref": "#/$defs/nonnegative"
                },
                "cpu_usec": {
                  "$ref": "#/$defs/nonnegative"
                },
                "io_bytes": {
                  "$ref": "#/$defs/nonnegative"
                },
                "memory_peak_bytes": {
                  "$ref": "#/$defs/nonnegative"
                },
                "pids_peak": {
                  "$ref": "#/$defs/nonnegative"
                }
              }
            },
            "audit_bytes": {
              "$ref": "#/$defs/blob"
            }
          }
        },
        "oracle_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "statement",
            "oracle_results_hash"
          ],
          "properties": {
            "approved": {
              "const": true
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "oracle_results_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "run_nonce": {
          "$ref": "#/$defs/hash"
        },
        "role_images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer",
            "executor",
            "approver",
            "verifier"
          ],
          "properties": {
            "producer": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "executor": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "approver": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "verifier": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "source_rules_hash",
        "commit",
        "tracked_regular_paths",
        "eligible_paths",
        "prefilter_exclusions",
        "tracked_inventory_hash",
        "eligible_paths_hash",
        "repo_fingerprint"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "source_rules_hash": {
          "$ref": "#/$defs/hash"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "tracked_regular_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "eligible_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "prefilter_exclusions": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "tracked_inventory_hash": {
          "$ref": "#/$defs/hash"
        },
        "eligible_paths_hash": {
          "$ref": "#/$defs/hash"
        },
        "repo_fingerprint": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[,\\\\\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[,\\\\\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
    }
  }
}
