# Set the default behavior for all files
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
# ``*.jsonl`` and ``*.ini`` were missing, so ``* text=auto`` gave them CRLF in
# a Windows working tree while the blob stayed LF. Any tool that hashes
# working-tree bytes then produced a digest that disagreed with the committed
# artifact (NO1-010B corpus provenance). Digests additionally normalise CRLF so
# they cannot depend on checkout configuration at all.
*.jsonl text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.bat text eol=crlf

# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary
*.ez binary
*.bz2 binary
*.swp binary
*.cache binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary
