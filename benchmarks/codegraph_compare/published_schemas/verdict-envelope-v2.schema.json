        "schema_version",
        "evaluation_stage",
        "publishable",
        "winner",
        "dominance_allowed",
        "unlock_allowed",
        "status",
        "authorization",
        "top_level_reasons",
        "expected_cells",
        "observed_receipts",
        "attempts_per_cell",
        "counters",
        "cell_diagnostics"
      ],
      "type": "object"
    }
  },
  "required": [
    "manifest_sha256",
    "decision_id",
    "decision_contract_sha256",
    "challenge",
    "ledger_counter",
    "ledger_prev_hash",
    "issued_at_ns",
    "verdict",
    "service_identity",
    "consumption_record",
    "ledger_head",
    "key_id",
    "algorithm",
    "signature"
  ],
  "type": "object"
}
