                "type": "array"
              },
              "repo_id": {
                "type": "string"
              }
            },
            "required": [
              "repo_id",
              "arm_id",
              "reasons"
            ],
            "type": "object"
          },
          "maxItems": 14,
          "type": "array"
        },
        "counters": {
          "additionalProperties": false,
          "properties": {
            "api_cost_usd": {
              "const": 0,
              "type": "number"
            },
            "input_tokens": {
              "const": 0,
              "type": "number"
            },
            "model_calls": {
              "const": 0,
              "type": "number"
            },
            "network_requests": {
              "const": 0,
              "type": "number"
            },
            "output_tokens": {
              "const": 0,
              "type": "number"
            },
            "provider_requests": {
              "const": 0,
              "type": "number"
            }
          },
          "required": [
            "model_calls",
            "provider_requests",
            "network_requests",
            "input_tokens",
            "output_tokens",
            "api_cost_usd"
          ],
          "type": "object"
        },
        "dominance_allowed": {
          "const": false
        },
        "evaluation_stage": {
          "const": "E0"
        },
        "expected_cells": {
          "const": 14
        },
        "observed_receipts": {
          "maximum": 14,
          "minimum": 0,
          "type": "integer"
        },
        "publishable": {
          "const": false
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "SETUP_QUALIFIED",
            "NOT_EVALUATED"
          ]
