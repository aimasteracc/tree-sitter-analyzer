{
  "$id": "no1-008a-verdict-envelope-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "challenge": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "consumption_record": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string"
        },
        "record": {
          "additionalProperties": false,
          "properties": {
            "challenge": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "type": "integer"
            },
            "event": {
              "enum": [
                "CHALLENGED",
                "VERIFYING",
                "CONSUMED",
                "FAILED"
              ]
            },
            "event_at_ns": {
              "type": "integer"
            },
            "issued_at_ns": {
              "type": "integer"
            },
            "manifest_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "prev_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "record_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "counter",
            "event",
            "challenge",
            "manifest_sha256",
            "issued_at_ns",
            "event_at_ns",
            "prev_hash",
            "record_hash"
          ],
          "type": "object"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "record",
        "key_id",
        "algorithm",
        "signature"
      ],
      "type": "object"
    },
    "decision_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "issued_at_ns": {
      "type": "integer"
    },
    "key_id": {
      "type": "string"
    },
    "ledger_counter": {
      "type": "integer"
    },
    "ledger_head": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string"
        },
        "record": {
          "additionalProperties": false,
          "properties": {
            "counter": {
              "type": "integer"
            },
            "record_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "counter",
            "record_hash"
          ],
          "type": "object"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "record",
        "key_id",
        "algorithm",
        "signature"
      ],
      "type": "object"
    },
    "ledger_prev_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "service_identity": {
      "additionalProperties": false,
      "properties": {
        "allowed_writable_mounts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "closure_manifest": {
          "additionalProperties": false,
          "patternProperties": {
            "^.+$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "closure_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "gid": {
          "type": "integer"
        },
        "interpreter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rootfs_readonly": {
          "type": "boolean"
