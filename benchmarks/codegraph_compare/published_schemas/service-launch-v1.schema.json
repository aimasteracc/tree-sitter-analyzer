{
  "$id": "no1-008a-service-launch-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "attestation": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "container_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "entrypoint": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "image_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "mounts": {
          "type": "array"
        },
        "network_mode": {
          "const": "none"
        },
        "process": {
          "type": "object"
        },
        "readonly_rootfs": {
          "const": true
        },
        "role": {
          "enum": [
            "executor",
            "approver",
            "auditor",
            "verifier",
            "decision_consumer"
          ]
        },
        "security_opt": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "container_id",
        "role",
        "image_id",
        "cmd",
        "entrypoint",
        "user",
        "readonly_rootfs",
        "mounts",
        "network_mode",
        "security_opt",
        "process"
      ],
      "type": "object"
    },
    "key_id": {
      "type": "string"
    },
    "signature": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "required": [
    "attestation",
    "key_id",
    "algorithm",
    "signature"
  ],
  "type": "object"
}
